<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The Windows application manifest embedded in electron.exe / bake-pi.exe.

  Everything here except <dpiAwareness> is Electron 44's own manifest, copied
  verbatim so that replacing the resource changes exactly one thing. Electron
  ships as per-monitor DPI aware v1 ("true/pm"), and v1 leaves the non-client
  frame at the primary monitor's DPI while Chromium insets the client area by
  the current monitor's frame thickness. On a 150% display next to a 100%
  primary that is a three-pixel band of frame colour inside the hairline on
  the left, right and bottom edges. PerMonitorV2 makes Windows scale the frame
  with the window, so the hairline is the same width on every side of every
  display. `bun run frame` holds every display to that.

  `scripts/manifest.ts` stamps this into the development electron.exe on
  install; `forge.config.ts` stamps it into the packaged executable. Both read
  this file, so it is the single source.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <disableWindowFiltering xmlns="http://schemas.microsoft.com/SMI/2011/WindowsSettings">true</disableWindowFiltering>
    </asmv3:windowsSettings>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <maxversiontested Id="10.0.18362.0"/>
    </application>
  </compatibility>
</assembly>
