{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A sandboxed preload is not a Node context: it gets a polyfilled subset
    // centred on contextBridge and ipcRenderer, plus the DOM of the frame it is
    // attached to. Node types are present because the polyfilled subset is
    // typed against them, not because `fs` is reachable.
    "lib": ["DOM", "ES2023"],
    "types": ["node"]
  },
  "include": ["src/preload/**/*.ts"],
  "exclude": ["src/preload/**/*.test.ts"]
}
